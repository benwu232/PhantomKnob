    "guide.welcome.intro" : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PhantomKnob 使用创新技术和专利算法把触控板体验带入全新维度。\n无需其它硬件，即可在触控板上像使用实体旋钮一样用旋钮手势快速精确地调整数值。\n而独创的双环旋钮与无级变速旋钮更突破了物理限制，为您带来超越实体旋钮的全新体验。"
          }
        }
      }
    },
