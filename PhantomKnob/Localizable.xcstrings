          "stringUnit": {
            "state": "translated",
            "value": "Press C key while turning knob to show the customization panel"
          }
        }
      }
    },
    "guide.step2.hintTitle": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "💡 使用键盘方向键微调倍率"
