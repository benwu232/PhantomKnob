      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After pressing this hotkey or enabling via the menu bar, use knob gestures to control sliders, steppers, or compatible controls under your cursor."
          }
