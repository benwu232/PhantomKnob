    "guide.step3.feature1.desc": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按下此快捷键或在菜单栏开启后，即可通过旋钮手势调节鼠标下的滑动条、步进器或适配控件。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After pressing this hotkey or enabling via the menu bar, use knob gestures to control sliders, steppers, or compatible controls under your cursor."
          }
        }
      }
    },
    "guide.step3.feature1.title": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全局激活热键：⌘ ⌥ K (Command + Option + K)。可在设置中修改。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Global Activation Hotkey: ⌘ ⌥ K (Command + Option + K). Customizable in Settings."
          }
        }
      }
    },
    "guide.step3.feature2.desc": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果您想临时使用旋钮，可以按住 Option 键并进行旋钮操作；如果在旋钮激活状态，按下 Option 键会临时退出。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold Option key for temporary knob activation. If already active, holding Option temporarily disables it."
          }
        }
      }
    },
    "guide.step3.feature2.title": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "临时切换：按住 Option 键"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Temporary Toggle: Hold Option Key"
          }
        }
      }
    },
    "guide.step3.feature3.desc": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用已经针对 CapCut (剪映)、QuickTime Player 等主流调色及剪辑软件的时间轴/音量/数值项进行了适配。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app is optimized for CapCut, QuickTime Player, and other major editing and color grading apps — supporting timeline, volume, and value controls."
          }
        }
      }
    },
    "guide.step3.feature3.title": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
