    "tutorial.step1.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rotate two fingers on the trackpad to directly adjust volume, screen brightness, and keyboard backlight."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过在触控板上旋转双指来直接调节音量、屏幕亮度和键盘灯。"
          }
        }
      }
    },
    "tutorial.step1.hotkey" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Double-click the status bar icon, or press ⌥Space to open/close the control panel."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "双击状态栏上的小圆圈图标，或者按 ⌥Space 快捷键可以呼出/关闭控制面板。"
          }
        }
      }
    },
    "tutorial.step1.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Welcome to PhantomKnob!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "欢迎使用 PhantomKnob!"
          }
        }
      }
    },
    "tutorial.step2.button" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
