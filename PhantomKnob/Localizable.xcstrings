    "guide.step2.hintLine1": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": " 旋转中按 ↑/↓ 增减 1.0x，按 ←/→ 增减 0.1x，按数字键 2-9 直接相乘。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While rotating: ↑/↓ adjusts by 1.0x, ←/→ adjusts by 0.1x, number keys 2–9 set multiplier directly."
          }
        }
      }
    },
    "guide.step2.hintLine2": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
