    "guide.step3.featureStatusbar.desc": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "双击状态栏里的图标，会弹出快捷旋钮面板，可以用旋钮手势方便地调整音量、屏幕亮度等。"
