    "guide.step1.detectedSuccess": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "🎉 恭喜！您已成功使用旋钮手势，请点击下一步继续。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "🎉 Congratulations! You've successfully used the knob gesture. Click Next to continue."
          }
        }
      }
    },
    "guide.step1.footer": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统将检测硬件是否支持旋钮手势；如果支持，执行旋钮手势，您将看到旋钮旋转并听到音量变化。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The system will detect whether your hardware supports knob gestures. If supported, perform the gesture — you will see the knob rotate and hear the volume change."
          }
        }
      }
    },
