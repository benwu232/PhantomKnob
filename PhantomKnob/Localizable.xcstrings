    "about.description": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PhantomKnob 使用创新技术和专利算法把旋钮手势引入触控板。\n通过它您可以在触控板上像使用实体旋钮一样操作虚拟旋钮快速精确地调整数值。\n而独创的双环旋钮与无级变速旋钮更为您带来超越实体旋钮的全新体验。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PhantomKnob uses innovative technology and patented algorithms to bring knob gestures to your trackpad. You can adjust values quickly and precisely on the trackpad, just like using a physical knob. The exclusive Dual-Ring Knob and Continuous Variable Knob bring you an experience that surpasses physical hardware."
          }
        }
      }
    },
    "about.openGuide": {
      "extractionState": "manual",
