    "guide.step2.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "练习双环与无级变速旋钮的精细调节、键盘微调及 HUD 定制"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Practice fine adjustment with Dual-Ring and CVK knobs, keyboard tuning, and HUD customization"
          }
