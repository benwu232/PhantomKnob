    "tutorial.step3.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When the panel is visible, gestures adjust the selected control. When hidden, gestures control any slider under your cursor in any app."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当面板显示时，手势优先改变选中的调节项；当面板隐藏时，手势将控制光标下任意应用的滑块。"
          }
        }
      }
    },
