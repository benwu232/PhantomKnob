    "guide.stepWelcome.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Welcome to PhantomKnob"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "欢迎使用 PhantomKnob"
          }
        }
      }
    },
    "guide.welcome.intro" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PhantomKnob uses innovative technology and patented algorithms to elevate your trackpad experience to a whole new dimension. No additional hardware required — adjust values quickly and precisely using knob gestures on the trackpad, just like a physical knob. The exclusive Dual-Ring Knob and Continuous Variable Knob break physical limits, delivering an experience beyond hardware knobs."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PhantomKnob 使用创新技术和专利算法把触控板体验带入全新维度。\n无需其它硬件，即可在触控板上像使用实体旋钮一样用旋钮手势快速精确地调整数值。\n而独创的双环旋钮与无级变速旋钮更突破了物理限制，为您带来超越实体旋钮的全新体验。"
          }
        }
      }
    },
