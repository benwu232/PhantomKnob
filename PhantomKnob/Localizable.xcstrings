    },
    "guide.step2.title": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "进阶旋钮使用与定制"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Advanced Knob Usage & Customization"
          }
        }
      }
