            "value": "无级变速旋钮"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuous Variable Knob (CVK)"
          }
        }
      }
    },
    "guide.step2.doubleKnobDesc1": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "双环（外环0.1倍，内环1.0倍）"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dual ring (outer: 0.1x, inner: 1.0x)"
          }
        }
      }
    },
    "guide.step2.doubleKnobDesc2": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据手指距离自动切换微调/粗调"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically switches fine/coarse tuning based on finger distance"
          }
        }
      }
    },
    "guide.step2.doubleKnobName": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
