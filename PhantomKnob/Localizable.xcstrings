    "guide.shortcuts.auxiliary.arrowsHorizontal": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以 0.1 倍为步长调整（增加 / 减少）旋转速度"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjust rotation speed in steps of 0.1x (increase/decrease)"
          }
        }
      }
    },
    "guide.shortcuts.auxiliary.arrowsVertical": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以 1.0 倍为步长调整（增加 / 减少）旋转速度"
