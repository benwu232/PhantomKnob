          "stringUnit": {
            "state": "translated",
            "value": "2. Move mouse cursor over the volume practice knob"
          }
        }
      }
    },
    "guide.step1.step3": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用两指接触触控板，并做旋转动作"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Place two fingers on the trackpad and perform a rotation gesture"
          }
        }
      }
    },
